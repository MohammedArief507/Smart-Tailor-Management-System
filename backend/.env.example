# MongoDB connection string — pick ONE of the options below.

# Option A (default): Local MongoDB via MongoDB Compass / a local MongoDB server.
# Install MongoDB Community Server, then open Compass and connect to confirm
# it's running at this address before starting the backend.
MONGO_URI=mongodb://127.0.0.1:27017/tailor-shop

# Option B: MongoDB Atlas (cloud). Uncomment the line below and comment out
# the local one above. If you get a "querySrv ECONNREFUSED" error using this
# on Windows, use Atlas's "Legacy URI String" toggle on the Connect screen
# instead — it gives a mongodb:// string (not mongodb+srv://) that avoids
# the DNS lookup some Windows networks block.
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tailor-shop?retryWrites=true&w=majority

# Secret key used to sign JWT tokens (use a long random string)
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the backend server will run on
PORT=5000
